# Configuración local de PostgreSQL para desarrollo
# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# --- Base de datos (propietario) ---
# Se usa para aplicar migraciones y cargar datos.
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_CONTRASENA
POSTGRES_PORT=5432

# --- API REST ---
# Rol con privilegios mínimos. Lo crea la migración 009_etapa6_api.sql.
# La API nunca se conecta con el propietario de la base.
API_DB_USER=app_api
API_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# --- Puertos de los servicios ---
# API REST: http://127.0.0.1:${API_PORT}
API_PORT=8000
# Frontend: http://127.0.0.1:${FRONT_PORT}
FRONT_PORT=5173
